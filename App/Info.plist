<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Only keys without an INFOPLIST_KEY build setting live here. -->
	<!-- The commit a build was made from, shown under Settings: pass PM_BUILD_COMMIT to xcodebuild. Empty by default (Scripts/generate_project.py). -->
	<key>PMBuildCommit</key>
	<string>$(PM_BUILD_COMMIT)</string>
	<!-- Manual recording (App/Reports/ManualRecorder.swift) keeps running after a start in the foreground. When-In-Use is enough; there is no Always. -->
	<!-- The Share Extension hands a shared link to the app as peoplemaps://share?text=… (Core/SharedLink.swift). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>electrocorp.peoplemaps</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>peoplemaps</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<!-- The map's land colour (UIColor.mapLand), so launch flows into the map without a white or black flash. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
